# Optional. Only NON-secret values may ever be placed in VITE_* variables (they are public in the browser bundle).
#
# Leave unset (recommended): the app calls the relative path /api. In development Vite proxies it to
# http://localhost:8080; in production the rewrite in vercel.json forwards it to your backend, so the
# authentication cookie stays first-party.
#
# Set only if the browser should call the backend directly (cross-origin). The backend must then run with
# COOKIE_SAMESITE=None, COOKIE_SECURE=true and CORS_ALLOWED_ORIGINS=<your frontend origin>.
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
