# Backend environment variables (names only; set real values in your host's dashboard, never commit them).
# Required in production:
DB_URL=jdbc:mysql://HOST:3306/DBNAME?sslMode=VERIFY_IDENTITY
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=                      # at least 32 random characters, e.g. `openssl rand -base64 48`
CORS_ALLOWED_ORIGINS=https://your-frontend.example   # comma separated, exact origins
# Optional:
PORT=8080
DB_POOL_SIZE=10
JWT_EXPIRY_MINUTES=60
COOKIE_SECURE=true               # keep true on HTTPS
COOKIE_SAMESITE=Lax              # Lax when /api is proxied by the frontend host; None for direct cross-site calls
COLLEGE_NAME=Your College Name   # printed on mark sheets
SWAGGER_ENABLED=false            # true only if you want API docs reachable
BOOTSTRAP_ADMIN_USERNAME=        # first deploy only: creates the first admin if none exists ...
BOOTSTRAP_ADMIN_PASSWORD=        # ... then remove both variables
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
